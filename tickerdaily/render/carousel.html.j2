<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  :root {
    --ink: #0A0E13; --panel: #121821; --line: #1F2833;
    --text: #F1F3F5; --muted: #8A96A3;
    --up: #2BD67B; --down: #FF5C5C; --bell: #F5B841;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #000; font-family: "Inter", "Helvetica Neue", Arial, sans-serif; color: var(--text);
         font-feature-settings: "tnum" 1, "cv11" 1; -webkit-font-smoothing: antialiased; }
  .slide { width: 1080px; height: 1350px; background: var(--ink); position: relative; overflow: hidden;
           padding: 88px 84px 84px; display: flex; flex-direction: column; }
  .slide::before { content: ""; position: absolute; inset: 0;
    background: radial-gradient(900px 600px at 100% 0%, rgba(245,184,65,.07), transparent 60%); pointer-events: none; }
  .top { display: flex; justify-content: space-between; align-items: center; font-size: 26px; color: var(--muted);
         letter-spacing: .02em; margin-bottom: 64px; }
  .brand { font-weight: 800; color: var(--text); letter-spacing: .06em; }
  .brand b { color: var(--bell); }
  .kicker { font-size: 26px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--bell); margin-bottom: 22px; }
  h1 { font-size: 104px; line-height: .98; font-weight: 800; letter-spacing: -.035em; }
  h2 { font-size: 64px; line-height: 1.04; font-weight: 800; letter-spacing: -.025em; margin-bottom: 40px; }
  .lede { font-size: 38px; line-height: 1.34; color: #C9D1D9; font-weight: 400; }
  .up { color: var(--up); } .down { color: var(--down); }
  .spacer { flex: 1; }
  .foot { display: flex; justify-content: space-between; font-size: 24px; color: var(--muted); padding-top: 36px;
          border-top: 2px solid var(--line); }

  /* cover */
  .tone { display: inline-flex; align-items: center; gap: 14px; font-size: 30px; font-weight: 700; padding: 14px 26px;
          border-radius: 999px; background: var(--panel); border: 2px solid var(--line); margin-bottom: 56px; align-self: flex-start; }
  .tone i { width: 16px; height: 16px; border-radius: 50%; display: block; }
  .strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .chip { background: var(--panel); border: 2px solid var(--line); border-radius: 22px; padding: 24px 22px; }
  .chip .n { font-size: 24px; color: var(--muted); margin-bottom: 10px; }
  .chip .v { font-size: 38px; font-weight: 800; letter-spacing: -.02em; }
  .swipe { font-size: 30px; font-weight: 700; color: var(--bell); margin-top: 40px; }

  /* wrap */
  .idx { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 48px; }
  .card { background: var(--panel); border: 2px solid var(--line); border-radius: 26px; padding: 34px 32px; }
  .card .n { font-size: 28px; color: var(--muted); }
  .card .p { font-size: 34px; margin: 10px 0 6px; color: #C9D1D9; }
  .card .c { font-size: 64px; font-weight: 800; letter-spacing: -.03em; }
  .breadth { margin-bottom: 44px; }
  .breadth .lab { display: flex; justify-content: space-between; font-size: 28px; margin-bottom: 14px; font-weight: 600; }
  .bar { height: 26px; border-radius: 13px; overflow: hidden; display: flex; background: var(--line); }

  /* spotlight */
  .tick { display: flex; align-items: baseline; gap: 26px; margin-bottom: 8px; }
  .tick .s { font-size: 132px; font-weight: 800; letter-spacing: -.04em; line-height: 1; }
  .tick .co { font-size: 34px; color: var(--muted); }
  .big { font-size: 96px; font-weight: 800; letter-spacing: -.035em; margin-bottom: 6px; }
  .meta { font-size: 30px; color: var(--muted); margin-bottom: 52px; }
  .why { background: var(--panel); border: 2px solid var(--line); border-left: 8px solid var(--bell); border-radius: 22px; padding: 40px 40px; }
  .why h3 { font-size: 40px; font-weight: 800; margin-bottom: 18px; letter-spacing: -.01em; }
  .why p { font-size: 34px; line-height: 1.4; color: #D3DAE0; }
  .earn { display: flex; gap: 18px; margin-top: 28px; }
  .earn div { flex: 1; background: var(--panel); border: 2px solid var(--line); border-radius: 20px; padding: 22px 24px; font-size: 26px; color: var(--muted); }
  .earn b { display: block; font-size: 36px; color: var(--text); margin-top: 6px; }
  .src { font-size: 24px; color: var(--muted); margin-top: 26px; }

  /* movers */
  .grp { font-size: 28px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 10px 0 20px; }
  .mv { display: grid; grid-template-columns: 170px 1fr 170px; align-items: center; gap: 22px; margin-bottom: 22px; }
  .mv .s { font-size: 40px; font-weight: 800; }
  .mv .s small { display: block; font-size: 22px; font-weight: 500; color: var(--muted); margin-top: 2px; }
  .mv .track { height: 58px; background: var(--panel); border-radius: 14px; overflow: hidden; }
  .mv .fill { height: 100%; border-radius: 14px; }
  .mv .pct { font-size: 40px; font-weight: 800; text-align: right; }

  /* next */
  .ev { display: grid; grid-template-columns: 1fr auto; gap: 8px 24px; background: var(--panel); border: 2px solid var(--line);
        border-radius: 24px; padding: 32px 34px; margin-bottom: 20px; }
  .ev .s { font-size: 46px; font-weight: 800; }
  .ev .w { font-size: 28px; color: var(--bell); font-weight: 700; text-align: right; align-self: center; }
  .ev .e { grid-column: 1 / -1; font-size: 28px; color: var(--muted); }
  .empty { font-size: 36px; color: var(--muted); }
  .cta { font-size: 44px; font-weight: 800; letter-spacing: -.02em; }
  .cta b { color: var(--bell); }
</style>
</head>
<body>
{% set n = 5 %}
{% macro top(i) %}<div class="top"><span class="brand">TICKER<b>.</b>DAILY</span><span>{{ f.date_label }} · {{ i }}/{{ n }}</span></div>{% endmacro %}
{% macro foot() %}<div class="foot"><span>@ticker.daily</span><span>Data: Finnhub, SEC EDGAR · Not financial advice</span></div>{% endmacro %}

<!-- 1 COVER -->
<section class="slide">
  {{ top(1) }}
  <div class="kicker">After the bell</div>
  <div class="tone"><i style="background: var(--{{ 'up' if f.market_tone == 'up' else 'down' if f.market_tone == 'down' else 'bell' }})"></i>
    Market {{ {'up': 'higher', 'down': 'lower', 'mixed': 'mixed'}[f.market_tone] }}</div>
  <h1>{{ p.hook }}</h1>
  <p class="lede" style="margin-top:36px">{{ p.cover_sub }}</p>
  <div class="spacer"></div>
  <div class="strip">
    {% for i in f.indexes %}<div class="chip"><div class="n">{{ i.name }}</div><div class="v {{ 'up' if i.up else 'down' }}">{{ i.change_pct }}</div></div>{% endfor %}
  </div>
  <div class="swipe">Swipe for the why →</div>
</section>

<!-- 2 MARKET WRAP -->
<section class="slide">
  {{ top(2) }}
  <div class="kicker">The scoreboard</div>
  <h2>How the market closed</h2>
  <div class="idx">
    {% for i in f.indexes %}
    <div class="card"><div class="n">{{ i.name }} <span style="opacity:.6">({{ i.symbol }})</span></div>
      <div class="p">{{ i.price }}</div><div class="c {{ 'up' if i.up else 'down' }}">{{ i.change_pct }}</div></div>
    {% endfor %}
  </div>
  {% set b = f.breadth %}
  <div class="breadth">
    <div class="lab"><span class="up">{{ b.up }} up</span><span style="color:var(--muted)">of {{ b.total }} big names we track</span><span class="down">{{ b.down }} down</span></div>
    <div class="bar"><div style="width:{{ (100 * b.up / (b.total or 1))|round(1) }}%;background:var(--up)"></div><div class="spacer"></div><div style="width:{{ (100 * b.down / (b.total or 1))|round(1) }}%;background:var(--down)"></div></div>
  </div>
  <p class="lede">{{ p.wrap_line }}</p>
  <div class="spacer"></div>
  {{ foot() }}
</section>

<!-- 3 SPOTLIGHT -->
{% set s = f.spotlight %}
<section class="slide">
  {{ top(3) }}
  <div class="kicker">Biggest story</div>
  <div class="tick"><span class="s">{{ s.symbol }}</span>{% if s.name != s.symbol %}<span class="co">{{ s.name }}</span>{% endif %}</div>
  <div class="big {{ 'up' if s.up else 'down' }}">{{ s.change_pct }}</div>
  <div class="meta">Closed at {{ s.price }}{% if s.day_range %} · Day range {{ s.day_range }}{% endif %}</div>
  <div class="why"><h3>{{ p.spotlight_title }}</h3><p>{{ p.spotlight_why }}</p></div>
  {% if s.earnings and s.earnings.eps_actual %}
  <div class="earn">
    <div>EPS vs est.<b>{{ s.earnings.eps_actual }} <span style="color:var(--muted);font-weight:500">/ {{ s.earnings.eps_estimate }}</span></b></div>
    {% if s.earnings.revenue_actual %}<div>Revenue vs est.<b>{{ s.earnings.revenue_actual }} <span style="color:var(--muted);font-weight:500">/ {{ s.earnings.revenue_estimate }}</span></b></div>{% endif %}
  </div>
  {% endif %}
  {% set srcs = (s.headlines | map(attribute='source') | unique | list) + (['SEC ' ~ s.filings[0].form] if s.filings else []) %}
  {% if srcs %}<div class="src">Sources: {{ srcs[:4] | join(', ') }}</div>{% endif %}
  <div class="spacer"></div>
  {{ foot() }}
</section>

<!-- 4 MOVERS -->
{% set maxabs = ((f.gainers + f.losers) | map(attribute='_raw_pct') | map('abs') | max) if (f.gainers + f.losers) else 1 %}
<section class="slide">
  {{ top(4) }}
  <div class="kicker">Movers</div>
  <h2>Winners and losers</h2>
  {% if f.gainers %}<div class="grp up">Top gainers</div>{% endif %}
  {% for m in f.gainers %}
  <div class="mv"><div class="s">{{ m.symbol }}{% if m.name != m.symbol %}<small>{{ m.name }}</small>{% endif %}</div>
    <div class="track"><div class="fill" style="width:{{ (8 + 92 * (m._raw_pct|abs) / maxabs)|round(1) }}%;background:var(--up)"></div></div>
    <div class="pct up">{{ m.change_pct }}</div></div>
  {% endfor %}
  {% if f.losers %}<div class="grp down" style="margin-top:28px">Top decliners</div>{% endif %}
  {% for m in f.losers %}
  <div class="mv"><div class="s">{{ m.symbol }}{% if m.name != m.symbol %}<small>{{ m.name }}</small>{% endif %}</div>
    <div class="track"><div class="fill" style="width:{{ (8 + 92 * (m._raw_pct|abs) / maxabs)|round(1) }}%;background:var(--down)"></div></div>
    <div class="pct down">{{ m.change_pct }}</div></div>
  {% endfor %}
  <p class="lede" style="margin-top:26px;font-size:34px">{{ p.movers_line }}</p>
  <div class="spacer"></div>
  {{ foot() }}
</section>

<!-- 5 WHAT'S NEXT -->
<section class="slide">
  {{ top(5) }}
  <div class="kicker">On deck</div>
  <h2>What to watch next</h2>
  {% for e in f.next_up %}
  <div class="ev"><div class="s">{{ e.symbol }} {% if e.name != e.symbol %}<span style="font-size:28px;color:var(--muted);font-weight:500">{{ e.name }}</span>{% endif %}</div>
    <div class="w">{{ e.when }}</div>
    <div class="e">{% if e.eps_estimate %}EPS est. {{ e.eps_estimate }}{% endif %}{% if e.revenue_estimate %} · Revenue est. {{ e.revenue_estimate }}{% endif %}</div></div>
  {% else %}
  <p class="empty">No major earnings on the calendar for the next session.</p>
  {% endfor %}
  <p class="lede" style="margin-top:22px;font-size:34px">{{ p.next_line }}</p>
  <div class="spacer"></div>
  <p class="cta">Follow <b>@ticker.daily</b> for the why behind every move.</p>
  <div style="height:36px"></div>
  {{ foot() }}
</section>
</body>
</html>
